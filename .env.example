# ---------------------------------------------------------------------------
# KaziUG environment. Copy to .env for local development.
# On Laravel Cloud, set these in the environment's "Variables" screen instead.
# ---------------------------------------------------------------------------

# local | production | testing. Production forces secure cookies and hides error details.
APP_ENV=local
# true shows stack traces in the browser. Must be false in production.
APP_DEBUG=true
# Public base URL, no trailing slash. Used in emails (confirm/unsubscribe links) and canonical tags.
APP_URL=http://localhost:8000
# 32 random bytes, base64 encoded, prefixed "base64:". Generate with:
#   php -r "echo 'base64:'.base64_encode(random_bytes(32)), PHP_EOL;"
# Used to derive the SMTP-password encryption key. Changing it makes the saved SMTP password unreadable.
APP_KEY=
# PHP timezone for display and scheduling.
APP_TIMEZONE=Africa/Kampala

# PostgreSQL. Laravel Cloud injects DB_HOST, DB_PORT, DB_DATABASE, DB_USERNAME, DB_PASSWORD
# when a database is attached to the environment.
DB_HOST=127.0.0.1
DB_PORT=5442
DB_DATABASE=kaziug
DB_USERNAME=kaziug
DB_PASSWORD=kaziug
# disable | prefer | require | verify-full. Use require (or stricter) in production.
DB_SSLMODE=prefer
# Alternative to the DB_* variables above (some platforms inject only this):
#   DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
# Any DB_* variable that is set takes precedence over the matching part of DATABASE_URL.
DATABASE_URL=
# Database used by the PHPUnit suite. It is wiped between tests: never point it at real data.
DB_TEST_DATABASE=kaziug_test

# Session cookie name.
SESSION_COOKIE=kaziug_session
# Admin is signed out after this many minutes without a request.
SESSION_IDLE_MINUTES=30
# Session rows (including visitors' CSRF-only sessions) are removed after this many idle minutes.
SESSION_LIFETIME_MINUTES=120

# Comma-separated proxy IPs whose X-Forwarded-* headers are trusted, or * to trust any.
# Laravel Cloud sits behind a load balancer: use *. Leave empty when serving directly.
TRUSTED_PROXIES=

# minimum level written to storage/logs: debug | info | warning | error
LOG_LEVEL=info

# Newsletter worker: maximum emails sent per minute (also the batch size per run).
NEWSLETTER_RATE_PER_MINUTE=60
# SMTP connection timeout in seconds, for every email the app sends.
MAIL_TIMEOUT=15
